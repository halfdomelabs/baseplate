# Path to local Baseplate VS Code extension for development (optional)
# Uncomment and set to your local extension path to mount it in the dev container
# BASEPLATE_DEV_EXTENSION_PATH=/path/to/your/local/baseplate-extension

# Path to local Baseplate documentation repository for development (optional)
# Uncomment and set to your local baseplate-docs repo path to mount it in the dev container
# BASEPLATE_DEV_DOCS_PATH=/path/to/your/local/baseplate-docs
