{
  "name": "@baseplate-dev/project-builder-lib",
  "version": "0.6.22",
  "description": "Plugin spec and loader system for Baseplate",
  "keywords": [
    "baseplate",
    "code-generation",
    "plugins",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MIT",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/project-builder-lib"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin-tools": "./dist/plugin-tools/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "lint": "oxlint",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc:watch": "tsc -p tsconfig.build.json --preserveWatchOutput -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseplate-dev/utils": "workspace:*",
    "es-toolkit": "catalog:",
    "globby": "catalog:"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@types/node": "catalog:",
    "memfs": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "zod": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
