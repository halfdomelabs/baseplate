{
  "extends": "@baseplate-dev/tools/tsconfig.vite.lib.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo",
    "composite": true,
    "incremental": true
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.ts",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "src/stories/**"
  ],
  "references": [
    {
      "path": "../utils/tsconfig.build.json"
    }
  ]
}
