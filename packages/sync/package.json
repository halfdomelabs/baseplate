{
  "name": "@baseplate-dev/sync",
  "version": "0.6.19",
  "description": "Library for syncing Baseplate descriptions",
  "keywords": [
    "baseplate",
    "code-generation",
    "full-stack",
    "sync-engine",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/sync"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extractor-test-utils": {
      "types": "./dist/templates/extractor/test-utils/index.d.ts",
      "import": "./dist/templates/extractor/test-utils/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "lint": "oxlint && eslint .",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "tsc:watch": "tsc -p tsconfig.build.json --preserveWatchOutput -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseplate-dev/utils": "workspace:*",
    "chalk": "^6.0.0",
    "es-toolkit": "^1.50.0",
    "execa": "^10.0.1",
    "fast-json-patch": "^3.1.1",
    "globby": "^16.2.2",
    "ignore": "^7.0.6",
    "micromatch": "^4.0.8",
    "ms": "^2.1.3",
    "node-diff3": "^3.2.1",
    "p-limit": "^7.3.1",
    "prettier": "catalog:",
    "yaml": "^2.8.3",
    "yaml-diff-patch": "^2.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@types/micromatch": "^4.0.10",
    "@types/ms": "0.7.34",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "memfs": "4.64.0",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
