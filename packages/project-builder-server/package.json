{
  "name": "@baseplate-dev/project-builder-server",
  "version": "0.6.16",
  "description": "Server for Project Builder using Baseplate generators",
  "keywords": [
    "backend",
    "baseplate",
    "code-generation",
    "full-stack",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/project-builder-server"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./template-extractor": "./dist/template-extractor/index.js",
    "./plugins": "./dist/plugins/index.js",
    "./actions": "./dist/actions/index.js",
    "./dev-server": "./dist/dev-server/index.js",
    "./user-config": "./dist/user-config/index.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "lint": "oxlint && eslint .",
    "test": "vitest",
    "tsc:watch": "tsc -p tsconfig.build.json --preserveWatchOutput -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseplate-dev/core-generators": "workspace:*",
    "@baseplate-dev/fastify-generators": "workspace:*",
    "@baseplate-dev/project-builder-lib": "workspace:*",
    "@baseplate-dev/react-generators": "workspace:*",
    "@baseplate-dev/sync": "workspace:*",
    "@baseplate-dev/utils": "workspace:*",
    "@fastify/helmet": "^13.0.2",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@trpc/server": "^11.18.0",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "es-toolkit": "^1.50.0",
    "execa": "^10.0.1",
    "fast-json-patch": "^3.1.1",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^7.0.0",
    "globby": "^16.2.2",
    "ignore": "^7.0.6",
    "immer": "~11.1.15",
    "inflection": "^3.0.2",
    "isbinaryfile": "^6.0.0",
    "micromatch": "^4.0.8",
    "mime": "^4.1.0",
    "open": "^11.0.0",
    "p-limit": "^7.3.1",
    "pino": "^10.3.1",
    "ts-morph": "^28.0.0",
    "zod": "catalog:",
    "zod-to-ts": "^2.1.0"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@types/micromatch": "^4.0.10",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "memfs": "4.64.0",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
