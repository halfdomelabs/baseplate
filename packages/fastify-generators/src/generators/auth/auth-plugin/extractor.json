{
  "name": "auth/auth-plugin",
  "templates": {
    "auth-plugin": {
      "type": "ts",
      "fileOptions": {
        "kind": "singleton"
      },
      "generator": "@baseplate-dev/fastify-generators#auth/auth-plugin",
      "importMapProviders": {
        "appRuntimeImportsProvider": {
          "importName": "appRuntimeImportsProvider",
          "packagePathSpecifier": "@baseplate-dev/fastify-generators:src/generators/core/app-runtime/generated/ts-import-providers.ts"
        },
        "authContextImportsProvider": {
          "importName": "authContextImportsProvider",
          "packagePathSpecifier": "@baseplate-dev/fastify-generators:src/generators/auth/auth-context/generated/ts-import-providers.ts"
        }
      },
      "pathRootRelativePath": "{module-root}/plugins/auth.plugin.ts",
      "sourceFile": "module/plugins/auth.plugin.ts",
      "variables": {}
    }
  }
}
