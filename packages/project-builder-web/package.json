{
  "name": "@baseplate-dev/project-builder-web",
  "version": "0.6.17",
  "description": "Web interface for constructing project builder JSON",
  "keywords": [
    "baseplate",
    "code-generation",
    "full-stack",
    "project-builder",
    "react",
    "typescript",
    "ui"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": "https://github.com/halfdomelabs/baseplate",
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./dist/*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "rm -rf ./dist",
    "dev": "vite",
    "dev:serve": "vite --clearScreen false",
    "lint": "oxlint && eslint .",
    "serve": "vite preview",
    "test": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@baseplate-dev/project-builder-lib": "workspace:*",
    "@baseplate-dev/ui-components": "workspace:*",
    "@baseplate-dev/utils": "workspace:*",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/lenses": "^0.8.1",
    "@hookform/resolvers": "^5.2.2",
    "@module-federation/enhanced": "catalog:",
    "@tanstack/react-router": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "culori": "^4.0.1",
    "es-toolkit": "^1.50.0",
    "immer": "~11.1.15",
    "inflection": "^3.0.2",
    "jsdom": "^30.0.1",
    "loglevel": "^1.9.2",
    "react": "catalog:",
    "react-colorful": "^5.8.0",
    "react-dom": "catalog:",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.7.0",
    "react-timeago": "^8.3.0",
    "semver": "^7.8.5",
    "zod": "catalog:",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@baseplate-dev/project-builder-server": "workspace:*",
    "@baseplate-dev/tools": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "1.168.23",
    "@types/culori": "^2.1.1",
    "@types/node": "catalog:",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "catalog:",
    "chokidar": "^5.0.0",
    "eslint": "catalog:",
    "mime": "^4.1.0",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-svgr": "catalog:",
    "vitest": "catalog:"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
