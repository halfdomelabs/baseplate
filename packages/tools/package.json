{
  "name": "@baseplate-dev/tools",
  "version": "0.6.22",
  "description": "Shared dev configurations for linting, formatting, and testing Baseplate projects",
  "keywords": [
    "baseplate",
    "code-generation",
    "configuration",
    "development-tools",
    "full-stack",
    "oxlint",
    "prettier",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MIT",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/tools"
  },
  "files": [
    "prettier.config.*.js",
    "tsconfig.*.json",
    "vitest.*.js",
    "src-subpath-import-plugin.js",
    "oxlint.config.base.js",
    "oxlint.config.base.d.ts",
    "oxfmt.config.*.js",
    "oxlint-plugins/**/*.js",
    "!vitest.config.js"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./oxlint-config-base": "./oxlint.config.base.js",
    "./tsconfig.node.cli.json": "./tsconfig.node.cli.json",
    "./tsconfig.node.lib.json": "./tsconfig.node.lib.json",
    "./tsconfig.node.script.json": "./tsconfig.node.script.json",
    "./tsconfig.vite.lib.json": "./tsconfig.vite.lib.json",
    "./tsconfig.vite.web.json": "./tsconfig.vite.web.json",
    "./vitest-node": "./vitest.config.node.js",
    "./vitest-react": "./vitest.config.react.js",
    "./src-subpath-import-plugin": "./src-subpath-import-plugin.js",
    "./oxfmt-config-base": "./oxfmt.config.base.js",
    "./oxfmt-config-react": "./oxfmt.config.react.js",
    "./oxlint-plugin-baseplate": "./oxlint-plugins/baseplate.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@tsconfig/vite-react": "^8.1.1"
  },
  "devDependencies": {
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
