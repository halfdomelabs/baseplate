{
  "name": "@baseplate-dev/project-builder-cli",
  "version": "0.6.16",
  "description": "Full-stack CLI builder using Baseplate generators",
  "keywords": [
    "baseplate",
    "cli",
    "code-generation",
    "development-tools",
    "full-stack",
    "scaffolding",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/project-builder-cli"
  },
  "bin": {
    "baseplate": "./bin/baseplate.js"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "bin/**/*"
  ],
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*": {
      "development": "./src/*",
      "default": "./dist/*"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "dev": "tsx watch --tsconfig ./tsconfig.app.json --exclude /**/node_modules/** --env-file-if-exists=../../.env --env-file-if-exists=.env -C development ./src/cli.ts",
    "lint": "oxlint && eslint .",
    "start": "tsx --tsconfig ./tsconfig.app.json --env-file-if-exists=../../.env --env-file-if-exists=.env -C development ./src/cli.ts",
    "test": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@baseplate-dev/project-builder-common": "workspace:*",
    "@baseplate-dev/project-builder-lib": "workspace:*",
    "@baseplate-dev/project-builder-server": "workspace:*",
    "@baseplate-dev/project-builder-web": "workspace:*",
    "@baseplate-dev/utils": "workspace:*",
    "commander": "^15.0.0",
    "package-directory": "^8.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "fastify": "^5.11.0",
    "memfs": "4.64.0",
    "oxlint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
