{
  "name": "@baseplate-dev/utils",
  "version": "0.6.17",
  "description": "Shared utility functions for Baseplate",
  "keywords": [
    "baseplate",
    "code-generation",
    "common",
    "full-stack",
    "helpers",
    "typescript",
    "utilities"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/halfdomelabs/baseplate",
    "directory": "packages/utils"
  },
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./dist/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/node.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "lint": "oxlint && eslint .",
    "test": "vitest",
    "tsc:watch": "tsc -p tsconfig.build.json --preserveWatchOutput -w",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "es-toolkit": "^1.50.0",
    "fastest-levenshtein": "^1.0.16",
    "nanoid": "^6.0.1",
    "sort-keys": "^6.0.1",
    "tinyqueue": "^3.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "memfs": "4.64.0",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
