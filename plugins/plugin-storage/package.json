{
  "name": "@baseplate-dev/plugin-storage",
  "version": "0.6.19",
  "description": "Contains the storage plugin for Baseplate",
  "keywords": [
    "baseplate",
    "code-generation",
    "file-storage",
    "full-stack",
    "plugin",
    "s3",
    "storage",
    "typescript"
  ],
  "homepage": "https://www.baseplate.dev",
  "license": "MPL-2.0",
  "author": "Half Dome Labs LLC",
  "repository": "https://github.com/halfdomelabs/baseplate",
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "dist/**/*",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*": "./dist/*",
    "#src/styles.css": "./src/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "concurrently pnpm:build:*",
    "build:static": "cpx \"src/**/{templates/**,static/**,plugin.json}\" \"dist/\" --clean",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:vite": "vite build",
    "clean": "rm -rf ./dist",
    "lint": "oxlint && eslint .",
    "test": "vitest --passWithNoTests",
    "tsc:watch": "tsc -p tsconfig.build.json --preserveWatchOutput -w",
    "typecheck": "tsc --noEmit",
    "watch": "concurrently pnpm:watch:*",
    "watch:static": "pnpm build:static --watch",
    "watch:vite": "nodemon --watch vite.config.ts --watch src --ignore \"**/generators/**\" -e ts,tsx,css,json --exec \"vite build\""
  },
  "dependencies": {
    "@baseplate-dev/core-generators": "workspace:*",
    "@baseplate-dev/fastify-generators": "workspace:*",
    "@baseplate-dev/plugin-ai": "workspace:*",
    "@baseplate-dev/plugin-queue": "workspace:*",
    "@baseplate-dev/project-builder-lib": "workspace:*",
    "@baseplate-dev/react-generators": "workspace:*",
    "@baseplate-dev/sync": "workspace:*",
    "@baseplate-dev/ui-components": "workspace:*",
    "@baseplate-dev/utils": "workspace:*",
    "@hookform/lenses": "^0.8.1",
    "@hookform/resolvers": "^5.2.2",
    "es-toolkit": "^1.50.0",
    "mime-types": "^3.0.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.71.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@baseplate-dev/tools": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/mime-types": "3.0.1",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "10.0.4",
    "cpx2": "catalog:",
    "eslint": "catalog:",
    "nodemon": "catalog:",
    "oxlint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "volta": {
    "extends": "../../package.json"
  }
}
