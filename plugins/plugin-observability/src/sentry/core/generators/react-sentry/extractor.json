{
  "name": "core/react-sentry",
  "templates": {
    "sentry": {
      "type": "ts",
      "fileOptions": { "kind": "singleton" },
      "generator": "@baseplate-dev/react-generators#core/react-sentry",
      "importMapProviders": {
        "reactConfigImportsProvider": {
          "importName": "reactConfigImportsProvider",
          "packagePathSpecifier": "@baseplate-dev/react-generators:src/generators/core/react-config/generated/ts-import-providers.ts"
        }
      },
      "pathRootRelativePath": "{src-root}/services/sentry.ts",
      "projectExports": {
        "initSentry": { "isTypeOnly": false, "name": "initSentry" },
        "logBreadcrumbToSentry": {
          "isTypeOnly": false,
          "name": "logBreadcrumbToSentry"
        },
        "logErrorToSentry": { "isTypeOnly": false, "name": "logErrorToSentry" }
      },
      "sourceFile": "src/services/sentry.ts",
      "variables": { "TPL_SENTRY_SCOPE_ACTIONS": {} }
    }
  }
}
