{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "target": "es2024",
    "lib": [
      "es2024",
      "esnext.array",
      "esnext.collection",
      "esnext.error",
      "esnext.iterator",
      "esnext.promise",
      "dom",
      "dom.iterable"
    ],
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "removeComments": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["**/node_modules", "**/dist", "**/lib"]
}
