{
  "name": "@blog-with-auth/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend app for blog-with-auth",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist/**/*",
    "prisma.config.ts",
    "prisma/**/*"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "concurrently pnpm:dev:*",
    "dev:server": "tsx watch --ignore /**/node_modules/** --clear-screen=false --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./src/instrument.ts src/index.ts | pino-pretty -t",
    "dev:workers": "tsx watch --ignore /**/node_modules/** --clear-screen=false --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./src/instrument.ts src/scripts/run-workers.ts | pino-pretty -t",
    "generate:schema": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/index.ts --exit-after-generate-schema",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier -w -l .",
    "prisma:generate": "prisma generate",
    "script:dev": "tsx watch --respawn --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./src/instrument.ts",
    "script:run": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local --import ./src/instrument.ts",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "start:workers": "node --import ./dist/instrument.js dist/scripts/run-workers.js",
    "test": "vitest run",
    "test:unit": "cross-env TEST_MODE=unit vitest run .unit.",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@blog-with-auth/transactional": "workspace:*",
    "@envelop/core": "5.3.0",
    "@envelop/disable-introspection": "8.0.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/request-context": "6.2.1",
    "@graphql-yoga/redis-event-target": "2.0.0",
    "@node-rs/argon2": "2.0.2",
    "@pothos/core": "4.10.0",
    "@pothos/plugin-prisma": "4.14.2",
    "@pothos/plugin-relay": "4.6.2",
    "@pothos/plugin-simple-objects": "4.1.3",
    "@pothos/plugin-tracing": "1.1.0",
    "@pothos/plugin-validation": "4.2.0",
    "@pothos/tracing-sentry": "1.1.4",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/core": "10.63.0",
    "@sentry/node": "10.63.0",
    "@sentry/profiling-node": "10.63.0",
    "es-toolkit": "1.44.0",
    "fastify": "5.8.5",
    "fastify-plugin": "6.0.0",
    "graphql": "16.14.0",
    "graphql-scalars": "1.23.0",
    "graphql-yoga": "5.15.1",
    "ioredis": "5.11.1",
    "nanoid": "6.0.0",
    "pg-boss": "12.26.3",
    "pino": "10.3.1",
    "postmark": "5.1.0",
    "rate-limiter-flexible": "11.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@envelop/types": "5.2.1",
    "@eslint/js": "9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/eslint-plugin": "1.6.23",
    "concurrently": "10.0.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-perfectionist": "5.10.0",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.3.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.1",
    "prettier-plugin-packagejson": "3.0.0",
    "prisma": "7.9.1",
    "tsc-alias": "1.8.10",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.0",
    "vitest": "4.1.7",
    "vitest-mock-extended": "3.1.1"
  },
  "engines": {
    "node": "^24.18.0",
    "pnpm": "^11.18.0"
  },
  "volta": {
    "node": "24.18.0"
  }
}
