generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

generator pothos {
  provider     = "pnpm prisma-pothos-types"
  clientOutput = "./client.js"
  output       = "../src/generated/prisma/pothos-prisma-types.ts"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("article")
}

model AuthVerification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String
  identifier String
  value      String
  userId     String?  @map("user_id") @db.Uuid
  metadata   Json?
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([type, identifier])
  @@map("auth_verification")
}

model Blog {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  userId    String     @map("user_id") @db.Uuid
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  members   BlogUser[]
  posts     BlogPost[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("blog")
}

model BlogPost {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blogId      String         @map("blog_id") @db.Uuid
  publisherId String         @map("publisher_id") @db.Uuid
  title       String
  content     String
  metadata    Json?
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  blog        Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  likes       BlogPostLike[]
  publisher   User           @relation(fields: [publisherId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("blog_post")
}

model BlogPostLike {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([postId, userId])
  @@index([postId, createdAt])
  @@map("blog_post_like")
}

model BlogUser {
  blogId    String         @map("blog_id") @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  blog      Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  notes     BlogUserNote[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([blogId, userId])
  @@map("blog_user")
}

model BlogUserNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blogId    String   @map("blog_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  note      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  blogUser  BlogUser @relation(fields: [blogId, userId], references: [blogId, userId], onDelete: Cascade, onUpdate: Restrict)

  @@map("blog_user_note")
}

model Notification {
  id              String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type            String
  templateVersion Int                    @default(1) @map("template_version")
  recipientId     String                 @map("recipient_id") @db.Uuid
  requestId       String?                @map("request_id") @db.Uuid
  inApp           Boolean                @default(true) @map("in_app")
  params          Json?
  frozenContent   Json?                  @map("frozen_content")
  seenAt          DateTime?              @map("seen_at") @db.Timestamptz(3)
  readAt          DateTime?              @map("read_at") @db.Timestamptz(3)
  dismissedAt     DateTime?              @map("dismissed_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt       DateTime?              @map("expires_at") @db.Timestamptz(3)
  groupKey        String                 @map("group_key")
  feedSortKey     String                 @unique @default(dbgenerated("uuidv7()")) @map("feed_sort_key") @db.Uuid
  deliveries      NotificationDelivery[]
  recipient       User                   @relation(fields: [recipientId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([type, groupKey, recipientId])
  @@unique([requestId, recipientId])
  @@index([recipientId, inApp, feedSortKey])
  @@index([expiresAt])
  @@index([recipientId, inApp, seenAt])
  @@map("notification")
}

model NotificationDelivery {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requestId      String       @map("request_id") @db.Uuid
  channel        String
  status         String       @default("pending")
  attempts       Int          @default(0)
  lastError      String?      @map("last_error")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  notificationId String       @map("notification_id") @db.Uuid
  deliveredAt    DateTime?    @map("delivered_at") @db.Timestamptz(3)
  feedSortKey    String       @map("feed_sort_key") @db.Uuid
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([notificationId, channel, feedSortKey])
  @@index([status, createdAt])
  @@map("notification_delivery")
}

model NotificationPreference {
  id                  String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  topicKey            String   @map("topic_key")
  channel             String
  mode                String
  digestWindowSeconds Int?     @map("digest_window_seconds")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([userId, topicKey, channel])
  @@index([userId, topicKey])
  @@map("notification_preference")
}

model NotificationRequest {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  type            String
  templateVersion Int      @default(1) @map("template_version")
  params          Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  frozenContent   Json?    @map("frozen_content")
  fanoutStatus    String   @default("pending") @map("fanout_status")

  @@index([fanoutStatus, createdAt])
  @@map("notification_request")
}

model RateLimiterFlexible {
  key    String    @id
  points Int
  expire DateTime? @db.Timestamptz(3)

  @@map("rate_limiter_flexible")
}

model User {
  id                      String                   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email                   String?                  @unique
  phone                   String?
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  name                    String?
  emailVerified           Boolean                  @default(false) @map("email_verified")
  accounts                UserAccount[]
  authVerifications       AuthVerification[]
  blogPostLikes           BlogPostLike[]
  blogPosts               BlogPost[]
  blogs                   Blog[]
  blogUsers               BlogUser[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  roles                   UserRole[]
  sessions                UserSession[]

  @@map("user")
}

model UserAccount {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  providerId String   @map("provider_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  accountId  String   @map("account_id")
  password   String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@unique([accountId, providerId])
  @@map("user_account")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      String
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([userId, role])
  @@map("user_role")
}

model UserSession {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  renewedAt DateTime @default(now()) @map("renewed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@map("user_session")
}
